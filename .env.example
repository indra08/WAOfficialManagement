# =============================================================================
# WA OFFICIAL MANAGEMENT — Environment Variables
# =============================================================================
# Salin file ini menjadi .env.local dan isi nilai yang sesuai.
# cp .env.example .env.local
#
# Untuk deployment di Cloudflare Pages, atur semua variabel ini di:
# Cloudflare Dashboard → Pages project → Settings → Environment Variables
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: kosongkan (database disabled, API return 503)
# Production: kosongkan juga — D1 binding otomatis dari Cloudflare Dashboard.
DATABASE_URL=""

# ── Authentication ────────────────────────────────────────────────────────────
# Minimal 32 karakter, WAJIB ganti di production
JWT_SECRET="dev-secret-key-change-in-production-min-32-chars-long!!!"

# ── WhatsApp / Meta ───────────────────────────────────────────────────────────
# META_APP_ID dan META_APP_SECRET TIDAK PERLU diatur di sini.
# Kredensial ini dimasukkan langsung oleh user pada halaman /dashboard/whatsapp
# saat menekan tombol "Lanjutkan ke Meta". Setiap akun memiliki kredensial sendiri.

# Webhook verification token — otomatis dihasilkan per koneksi (disimpan di DB).
# Kosongkan saja; sistem akan generate secara otomatis saat connect.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Base URL aplikasi (lokal atau production).
NEXT_PUBLIC_BASE_URL=https://wanago.pages.dev

# Base URL publik untuk webhook (harus reachable oleh Meta server = HTTPS di production).
WEBHOOK_BASE_URL=https://wanago.pages.dev

# ── Stripe (opsional — kosongkan jika belum dipakai) ───────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
